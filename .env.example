# Required SOCKS5 endpoint. Podman exposes a host-local proxy through this alias.
# IPv4 addresses and ASCII hostnames are accepted; IPv6 is not supported in v1.
VPNGATE2SOCKS_UPSTREAM=host.containers.internal:1080

# Set both or leave both unset for an unauthenticated upstream.
VPNGATE2SOCKS_UPSTREAM_USER=
VPNGATE2SOCKS_UPSTREAM_PASSWORD=

# LAN mode is disabled in the default container profile. Host ports remain on 127.0.0.1.
RUST_LOG=vpngate2socks=info,tower_http=info
